{
  "version": 1,
  "id": "openfilm-text-elements-v1",
  "source": "provided-text-elements",
  "defaults": {
    "fontSize": 88,
    "bold": true,
    "italic": false,
    "underline": false
  },
  "elements": {
    "fonts": [
      {
        "id": "simhei",
        "name": "黑体",
        "family": "SimHei",
        "fontPath": "openfilm-font:simhei"
      },
      {
        "id": "element-fangtang-j",
        "name": "方糖体",
        "family": "WenYue FangTangTi (Authorization Required) J",
        "fontPath": "openfilm-font:element-fangtang-j"
      },
      {
        "id": "element-xinqingnian-w8-j",
        "name": "新青年体",
        "family": "WenYue XinQingNianTi (Authorization Required) W8-J",
        "fontPath": "openfilm-font:element-xinqingnian-w8-j"
      }
    ],
    "colors": [
      "#FFFFFF",
      "#000000",
      "#F2DA2D",
      "#FFBD29",
      "#FF6B8A",
      "#1E40AF",
      "#4CAF50",
      "#EE7FFB",
      "#FF0000",
      "#F8AF72"
    ],
    "strokes": [
      {
        "color": "#4155C8",
        "width": 14
      },
      {
        "color": "#FFDE00",
        "width": 14
      },
      {
        "color": "#CD1F3C",
        "width": 14
      },
      {
        "color": "#000000",
        "width": 14
      },
      {
        "color": "#E63946",
        "width": 14
      },
      {
        "color": "#E85D75",
        "width": 14
      },
      {
        "color": "#2563EB",
        "width": 14
      }
    ],
    "shadows": [],
    "types": []
  },
  "selection": {
    "independentPools": [
      "fonts",
      "colors",
      "strokes",
      "shadows"
    ],
    "emptyPools": "omit-the-property",
    "unsupportedProperties": "never-synthesize",
    "colorPairRule": "fill/stroke contrast >= 3:1; compatible pairs weighted by color weight * stroke weight, normalized over valid pairs",
    "weightRule": "probability = item weight / pool total; missing weight = 1; zero disables; negative/nonfinite/all-zero rejected"
  },
  "weights": {
    "fonts": {
      "simhei": 1,
      "element-fangtang-j": 2,
      "element-xinqingnian-w8-j": 2
    },
    "colors": {
      "#FFFFFF": 3,
      "#000000": 3,
      "#F2DA2D": 3,
      "#FFBD29": 1,
      "#FF6B8A": 1,
      "#1E40AF": 3,
      "#4CAF50": 1,
      "#EE7FFB": 1,
      "#FF0000": 2,
      "#F8AF72": 1
    },
    "strokes": {
      "#4155C8:14": 2,
      "#FFDE00:14": 1,
      "#CD1F3C:14": 1,
      "#000000:14": 2,
      "#E63946:14": 2,
      "#E85D75:14": 1,
      "#2563EB:14": 1
    }
  }
}
