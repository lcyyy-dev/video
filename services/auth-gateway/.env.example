GATEWAY_SECRET=replace-with-at-least-32-random-characters
# Keygen CE singleplayer API; use an account-scoped URL if required by your installation.
KEYGEN_URL=http://host.docker.internal:3300/v1
KEYGEN_TOKEN=replace-with-server-side-admin-token
SUB2API_URL=http://host.docker.internal:8189/v1
MAPPING_FILE=/data/mappings.json
# Volcengine Speech key, kept exclusively on this server. TTS bypasses sub2api.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_SPEAKERS=zh_female_vv_uranus_bigtts
