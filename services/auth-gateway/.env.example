GATEWAY_SECRET=replace-with-at-least-32-random-characters
# Keygen CE singleplayer API; use an account-scoped URL if required by your installation.
KEYGEN_URL=http://host.docker.internal:3300/v1
KEYGEN_TOKEN=replace-with-server-side-admin-token
SUB2API_URL=http://host.docker.internal:8189/v1
MAPPING_FILE=/data/mappings.json
# Volcengine Speech key, kept exclusively on this server. TTS bypasses sub2api.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_SPEAKERS=zh_female_vv_uranus_bigtts,zh_female_gujie_uranus_bigtts,zh_female_zhishuaiyingzi_uranus_bigtts,zh_male_xionger_uranus_bigtts,zh_male_silang_uranus_bigtts,zh_male_wennuanahu_uranus_bigtts,zh_male_jieshuoxiaoming_uranus_bigtts,zh_male_yizhipiannan_uranus_bigtts,zh_female_tvbnv_uranus_bigtts,zh_male_qingshuangnanda_uranus_bigtts

# Optional public health endpoint exposed by YOUR independently installed tunnel/proxy.
# No tunnel/proxy software or credentials are included in this image.
MONITOR_PUBLIC_URL=
MONITOR_INTERVAL_MS=30000
# Set a registry/image tag when deploying the same image to another server.
GATEWAY_IMAGE=openfilm-auth-gateway:local

# PostgreSQL database dedicated to gateway logs. Create database/roles before starting.
LOG_DATABASE_URL=postgresql://log_writer:replace-me@host.docker.internal:5432/openfilm_gateway_logs
# Optional read-only role for the admin application; grant SELECT after initialization.
LOG_DATABASE_READ_URL=
